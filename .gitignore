# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and credentials. Never commit these.
.env
.env.*
*.pem
*.key
!data/**/*.pub

# Third party tool state. These are per machine, per tool, per install, and
# carry no information about the project. A project id committed here means one
# person's tool was initialised, and every other clone then carries an id that
# means nothing to them and differs from theirs.
.freebuff/
.codex/
.agents/
.continue/
.cursor/
.cline/
# Agent session scratch
*.session.json
scratch/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Evidence artifacts. These may contain client invoices and are never in git.
data/evidence/
data/fixtures/private/
*.eir
*.screenshot.png
